DATABASE_URL="postgresql://knowme:knowme@localhost:5432/knowme?schema=public"
# Sauvegardes PostgreSQL KMD-216 : secret HMAC dédié (>=32 caractères), différent de tous les autres secrets.
# Il signe les manifests de backup et doit être disponible lors d'une restauration signée.
KNOWME_BACKUP_MANIFEST_SIGNING_KEY=""
# Politique de rétention locale KMD-218/219. Une release marché doit choisir explicitement ces valeurs
# selon le RPO réel et la politique légale/opérationnelle approuvée (pas de valeur implicite en release).
KNOWME_BACKUP_RETENTION_DAYS=""
KNOWME_BACKUP_KEEP_MINIMUM=""
# KMD-220 : âge maximal acceptable du backup signé le plus récent. À choisir selon le RPO approuvé.
KNOWME_BACKUP_MAX_AGE_HOURS=""
JWT_SECRET=""
NEXT_PUBLIC_API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
# Ressources publiques de release marché. Elles doivent être réellement publiées en HTTPS et juridiquement validées avant soumission store.
PUBLIC_PRIVACY_POLICY_URL="https://knowme.example/privacy"
PUBLIC_TERMS_URL="https://knowme.example/terms"
# Ressource Web externe permettant à un titulaire de compte d'initier la suppression de son compte/données.
PUBLIC_ACCOUNT_DELETION_URL="https://knowme.example/account/data-rights"
# En production : tableau JSON d'origines Web HTTPS exactes, sans wildcard, chemin, query ni fragment.
CORS_ALLOWED_ORIGINS_JSON='["https://knowme.example"]'
PORT=4000
# KMD-221/223 : quota HTTP process-local. Une release marché doit choisir explicitement ces valeurs selon le trafic attendu.
API_RATE_LIMIT_TTL_MS=""
API_RATE_LIMIT_LIMIT=""
# Le throttler actuel n'est pas partagé entre processus : une release doit rester à 1 instance API tant qu'un limiter partagé/edge n'est pas validé.
API_INSTANCE_COUNT=""
# KMD-222 : nombre exact de reverse-proxy hops de confiance devant l'API (0..5).
# Choisir cette valeur depuis la topologie réelle ; 0 = ne faire confiance à aucun header client forwarded.
TRUSTED_PROXY_HOPS=""
# KMD-226 : timeouts du serveur HTTP Node. Une release marché doit choisir explicitement des valeurs cohérentes.
# Requête totale: 5s..120s ; headers: 1s..60s et <= requête ; keep-alive: 1s..30s et < requête.
API_REQUEST_TIMEOUT_MS=""
API_HEADERS_TIMEOUT_MS=""
API_KEEP_ALIVE_TIMEOUT_MS=""

# Stockage privé des médias. `local` est réservé au développement/test ; une release marché exige `s3`.
MEDIA_STORAGE_DRIVER="local"
MEDIA_ACCOUNT_QUOTA_BYTES=524288000
# KMD-227 : budget mémoire maximal par upload accepté. Une release marché doit le choisir explicitement selon la mémoire et la concurrence réelles.
# Valeur autorisée : 1 MiB..25 MiB. Le flux actuel utilise Multer memoryStorage(), donc ce plafond doit rester conservateur.
MEDIA_UPLOAD_MAX_BYTES=""
# Endpoint S3-compatible privé (AWS S3, Cloudflare R2, MinIO managé, etc.). HTTPS obligatoire en production.
MEDIA_S3_ENDPOINT=""
MEDIA_S3_BUCKET=""
MEDIA_S3_REGION=""
MEDIA_S3_ACCESS_KEY_ID=""
MEDIA_S3_SECRET_ACCESS_KEY=""
# Optionnel pour des credentials temporaires STS.
MEDIA_S3_SESSION_TOKEN=""
# Résilience bornée du stockage objet : timeout 1s..60s, nombre total de tentatives 1..5.
MEDIA_S3_TIMEOUT_MS=30000
MEDIA_S3_MAX_ATTEMPTS=3
# Ne jamais rendre le bucket public : les téléchargements restent autorisés par les grants KnowMe et transitent par l'API.

# Récupération de compte. Obligatoire pour une release marché.
# Utiliser un secret dédié, différent de JWT_SECRET, d'au moins 32 caractères aléatoires.
ACCOUNT_RECOVERY_ENABLED=true
ACCOUNT_RECOVERY_SECRET=""
# Endpoint HTTPS d'un fournisseur e-mail acceptant une enveloppe compatible Resend : from, to, subject, html.
ACCOUNT_RECOVERY_EMAIL_ENDPOINT=""
ACCOUNT_RECOVERY_EMAIL_API_KEY=""
# Identité expéditeur vérifiée chez le fournisseur, par ex. KnowMe <security@example.com>.
ACCOUNT_RECOVERY_EMAIL_FROM=""
# Durée de conservation des traces anti-abus de récupération. Aucune valeur légale universelle n'est imposée :
# elle doit être explicitement choisie/validée pour la release (1..3650 jours).
ACCOUNT_RECOVERY_ATTEMPT_RETENTION_DAYS=""
# La maintenance de purge doit rester active pour une release marché.
ACCOUNT_RECOVERY_RETENTION_MAINTENANCE_ENABLED=true
ACCOUNT_RECOVERY_RETENTION_INTERVAL_MS=3600000
ACCOUNT_RECOVERY_RETENTION_BATCH_SIZE=500

# Nexus × KnowMe — désactivé par défaut. La même valeur secrète doit être configurée côté serveur Nexus.
NEXUS_INTEGRATION_ENABLED=false
NEXUS_KNOWME_SHARED_SECRET=""
# URL serveur Nexus. HTTPS obligatoire en production. Jamais exposée comme NEXT_PUBLIC_*.
NEXUS_SERVER_URL="https://nexus.example.com"
# Nexus Social possède son propre kill switch en plus du kill switch global.
NEXUS_SOCIAL_ENABLED=false
NEXUS_SOCIAL_TIMEOUT_MS=20000
# Nettoyage borné des conversations/réponses Nexus devenues orphelines après changements de compte.
NEXUS_SOCIAL_MAINTENANCE_ENABLED=true
NEXUS_SOCIAL_MAINTENANCE_INTERVAL_MS=60000
NEXUS_SOCIAL_MAINTENANCE_BATCH_SIZE=100
# JSON d'identifiants Nexus autorisés à déclencher les capacités operator/destructive.
# Vide = aucune action destructive possible.
NEXUS_KNOWME_OPERATOR_NEXUS_IDS_JSON="[]"

# Centre de notifications intelligent et résumés in-app.
NOTIFICATION_CENTER_DIGEST_ENABLED=true
NOTIFICATION_CENTER_DIGEST_INTERVAL_MS=60000
NOTIFICATION_CENTER_DIGEST_BATCH_SIZE=500

# Game Platform autoritaire : expiration bornée des invitations et parties abandonnées.
GAME_PLATFORM_MAINTENANCE_ENABLED=true
GAME_PLATFORM_MAINTENANCE_INTERVAL_MS=60000
GAME_PLATFORM_MAINTENANCE_BATCH_SIZE=100

# Matchmaking social volontaire : expiration et remise en file bornées.
SOCIAL_MATCHMAKING_MAINTENANCE_ENABLED=true
SOCIAL_MATCHMAKING_MAINTENANCE_INTERVAL_MS=60000
SOCIAL_MATCHMAKING_MAINTENANCE_BATCH_SIZE=100

# Appels autoritaires : expiration bornée des sonneries et appels manqués.
CALL_MAINTENANCE_ENABLED=true
CALL_MAINTENANCE_INTERVAL_MS=15000
CALL_MAINTENANCE_BATCH_SIZE=100

# Configuration ICE livrée par l'API. Utiliser uniquement des relais contrôlés en production.
CALL_STUN_URLS_JSON='["stun:stun.example.com:3478"]'
CALL_TURN_URLS_JSON='["turns:turn.example.com:5349?transport=tcp","turn:turn.example.com:3478?transport=udp"]'
# Secret partagé avec coturn REST API ; au moins 32 octets aléatoires, jamais envoyé au client.
CALL_TURN_SECRET=""
CALL_TURN_TTL_SECONDS=600
CALL_REQUIRE_TURN_IN_PRODUCTION=true

# Stickers signés. En production, utiliser une clé dédiée d'au moins 32 caractères.
STICKER_TOKEN_ACTIVE_KEY_ID="primary"
STICKER_TOKEN_ACTIVE_SECRET=""
# Anciennes clés conservées pendant la rotation : [{"id":"old","secret":"..."}]
STICKER_TOKEN_PREVIOUS_KEYS_JSON="[]"
# Durée de validité des messages stickers persistés. Valeur par défaut : 365 jours.
STICKER_TOKEN_TTL_MS=31536000000

# URLs publiques KnowMe. Utiliser HTTPS en production.
PAYMENTS_PUBLIC_API_URL=""
PAYMENTS_RETURN_URL=""

# Générer 32 octets aléatoires puis les encoder en base64.
PAYMENTS_DATA_ENCRYPTION_KEY=""
PAYMENTS_FRAUD_HASH_SALT=""

# Prix Web supplémentaires, notamment CinetPay selon la devise réelle du compte marchand.
# Exemple de forme uniquement :
# [{"productKey":"premium_monthly","provider":"CINETPAY","platform":"WEB","countryCode":"BJ","currency":"XOF","unitAmount":12000}]
PAYMENTS_WEB_CATALOG_JSON="[]"

# Catalogue mobile autoritaire, sans prix fourni par le client.
# Exemple de forme uniquement :
# [{"productKey":"premium_monthly","provider":"GOOGLE_PLAY","platform":"ANDROID","currency":"USD","unitAmount":2000,"externalProductId":"..."}]
PAYMENTS_STORE_CATALOG_JSON="[]"

FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET=""

CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET=""

GOOGLE_PACKAGE_NAME=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_PUBSUB_AUDIENCE=""
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=""

APPLE_KEY_ID=""
APPLE_ISSUER_ID=""
APPLE_TEAM_ID=""
APPLE_PRIVATE_KEY=""
APPLE_BUNDLE_ID=""
APPLE_APP_ID=""
# Tableau JSON contenant les certificats racines Apple complets au format PEM.
APPLE_ROOT_CA_PEMS_JSON="[]"

# Réservé à une intégration future ; non utilisé par KMD-032.
STRIPE_OPTIONAL_KEY=""