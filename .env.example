DATABASE_URL="postgresql://knowme:knowme@localhost:5432/knowme?schema=public"
JWT_SECRET=""
NEXT_PUBLIC_API_URL="http://localhost:4000"
PORT=4000

# Centre de notifications intelligent et résumés in-app.
NOTIFICATION_CENTER_DIGEST_ENABLED=true
NOTIFICATION_CENTER_DIGEST_INTERVAL_MS=60000
NOTIFICATION_CENTER_DIGEST_BATCH_SIZE=500

# Stickers signés. En production, utiliser une clé dédiée d'au moins 32 caractères.
STICKER_TOKEN_ACTIVE_KEY_ID="primary"
STICKER_TOKEN_ACTIVE_SECRET=""
# Anciennes clés conservées pendant la rotation : [{"id":"old","secret":"..."}]
STICKER_TOKEN_PREVIOUS_KEYS_JSON="[]"
# Durée de validité des messages stickers persistés. Valeur par défaut : 365 jours.
STICKER_TOKEN_TTL_MS=31536000000

# URLs publiques KnowMe. Utiliser HTTPS en production.
PAYMENTS_PUBLIC_API_URL=""
PAYMENTS_RETURN_URL=""

# Générer 32 octets aléatoires puis les encoder en base64.
PAYMENTS_DATA_ENCRYPTION_KEY=""
PAYMENTS_FRAUD_HASH_SALT=""

# Prix Web supplémentaires, notamment CinetPay selon la devise réelle du compte marchand.
# Exemple de forme uniquement :
# [{"productKey":"premium_monthly","provider":"CINETPAY","platform":"WEB","countryCode":"BJ","currency":"XOF","unitAmount":12000}]
PAYMENTS_WEB_CATALOG_JSON="[]"

# Catalogue mobile autoritaire, sans prix fourni par le client.
# Exemple de forme uniquement :
# [{"productKey":"premium_monthly","provider":"GOOGLE_PLAY","platform":"ANDROID","currency":"USD","unitAmount":2000,"externalProductId":"..."}]
PAYMENTS_STORE_CATALOG_JSON="[]"

FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET=""

CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET=""

GOOGLE_PACKAGE_NAME=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_PUBSUB_AUDIENCE=""
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=""

APPLE_KEY_ID=""
APPLE_ISSUER_ID=""
APPLE_TEAM_ID=""
APPLE_PRIVATE_KEY=""
APPLE_BUNDLE_ID=""
APPLE_APP_ID=""
# Tableau JSON contenant les certificats racines Apple complets au format PEM.
APPLE_ROOT_CA_PEMS_JSON="[]"

# Réservé à une intégration future ; non utilisé par KMD-032.
STRIPE_OPTIONAL_KEY=""
