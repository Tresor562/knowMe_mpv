{
  "expo": {
    "name": "KnowMe",
    "slug": "knowme",
    "version": "1.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "knowme",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Autoriser KnowMe à protéger les secrets de connexion avec Face ID."
        }
      ],
      "./plugins/with-animated-chat-media.cjs",
      "./plugins/with-knowme-story-video.cjs",
      "./plugins/with-knowme-gallery.cjs",
      "./plugins/withKnowMeInstaller"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.knowme.app",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.knowme.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#071410"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
