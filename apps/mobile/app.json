{
  "expo": {
    "name": "KnowMe",
    "slug": "knowme",
    "version": "1.1.2",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "knowme",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Autoriser KnowMe à protéger les secrets de connexion avec Face ID."
        }
      ],
      "./plugins/with-animated-chat-media.cjs",
      "./plugins/with-knowme-gallery.cjs",
      "./plugins/with-knowme-voice.cjs",
      "./plugins/with-knowme-story-video.cjs",
      "./plugins/withKnowMeInstaller",
      "./plugins/withKnowMeNotificationIcon.cjs"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.knowme.app",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.knowme.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/knowme-adaptive-foreground.png",
        "monochromeImage": "./assets/branding/knowme-monochrome.png",
        "backgroundColor": "#0D0825"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "knowme-nextech.vercel.app",
              "pathPrefix": "/open/v1/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "icon": "./assets/branding/knowme-icon.png",
    "splash": {
      "image": "./assets/branding/knowme-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0825"
    }
  }
}
