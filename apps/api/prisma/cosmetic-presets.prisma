model CosmeticPreset {
  id              String   @id @default(cuid())
  userId          String
  name            String
  isDefault       Boolean  @default(false)
  lastActivatedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items CosmeticPresetItem[]

  @@unique([userId, name])
  @@index([userId, isDefault, updatedAt])
}

model CosmeticPresetItem {
  id        String   @id @default(cuid())
  presetId  String
  slot      String
  itemId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preset CosmeticPreset         @relation(fields: [presetId], references: [id], onDelete: Cascade)
  item   CosmeticItemDefinition @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([presetId, slot])
  @@index([itemId])
}
