model AffinityGamePreference {
  userId              String   @id
  invitationsEnabled  Boolean  @default(true)
  friendsOnly         Boolean  @default(true)
  defaultShareAnswers Boolean  @default(false)
  version             Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([invitationsEnabled, friendsOnly])
}
