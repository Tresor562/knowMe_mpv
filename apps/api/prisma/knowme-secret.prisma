enum SecretCampaignStatus {
  ACTIVE
  PAUSED
  CLOSED
  EXPIRED
}

enum SecretMessageStatus {
  DELIVERED
  PENDING_REVIEW
  BLOCKED
  ARCHIVED
  DELETED
}

model SecretPage {
  id                           String   @id @default(cuid())
  ownerId                      String   @unique
  slug                         String   @unique
  displayName                  String
  avatarUrl                    String?
  presentation                 String   @default("Pose-moi une question anonymement 👇")
  defaultPrompt                String   @default("Envoie-moi un message anonyme")
  enabled                      Boolean  @default(false)
  profileEntryEnabled          Boolean  @default(true)
  allowUnauthenticatedSenders  Boolean  @default(true)
  requireChallengeVerification Boolean @default(false)
  minimumAccountAgeHours       Int      @default(0)
  dailyLimitPerSender          Int      @default(10)
  acceptedCategories           String   @default("QUESTION,COMPLIMENT,CONFESSION,FEEDBACK")
  blockedTerms                 Json     @default("[]")
  pausedUntil                  DateTime?
  publicMessageCountVisible    Boolean  @default(false)
  messageCount                 Int      @default(0)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  campaigns SecretCampaign[]
  messages  SecretMessage[]
  blocks    SecretBlock[]

  @@index([enabled, profileEntryEnabled])
}

model SecretCampaign {
  id              String               @id @default(cuid())
  pageId          String
  token           String               @unique
  prompt          String
  category        String               @default("QUESTION")
  source          String               @default("SHARED_LINK")
  status          SecretCampaignStatus @default(ACTIVE)
  expiresAt       DateTime?
  maximumMessages Int?
  messageCount    Int                  @default(0)
  shareCount      Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  page     SecretPage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  messages SecretMessage[]

  @@index([pageId, status, createdAt])
}

model SecretMessage {
  id                  String              @id @default(cuid())
  pageId              String
  campaignId          String?
  category            String
  content             String
  senderTokenHash     String
  senderAuthenticated Boolean             @default(false)
  moderationRiskScore Int                 @default(0)
  status              SecretMessageStatus @default(DELIVERED)
  openedAt            DateTime?
  archivedAt          DateTime?
  createdAt           DateTime            @default(now())

  page     SecretPage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  campaign SecretCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  reply    SecretPublicReply?

  @@index([pageId, status, createdAt])
  @@index([pageId, senderTokenHash, createdAt])
  @@index([campaignId, createdAt])
}

model SecretBlock {
  id              String   @id @default(cuid())
  pageId          String
  senderTokenHash String
  reason          String?
  createdAt       DateTime @default(now())

  page SecretPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, senderTokenHash])
  @@index([pageId, createdAt])
}

model SecretPublicReply {
  id           String   @id @default(cuid())
  messageId    String   @unique
  answer       String
  visibility   String   @default("PUBLIC")
  shareCaption String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  message SecretMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}
