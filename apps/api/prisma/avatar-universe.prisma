/// Server-authoritative, versioned Avatar DNA.
/// Cosmetic ownership remains in Cosmetics; this model stores only body/face/personality/render state.
model AvatarIdentityProfile {
  userId             String   @id
  schemaVersion      Int      @default(1)
  revision           Int      @default(1)
  morphology         Json
  personality        Json
  renderTier         String   @default("REALTIME_3D_BALANCED")
  baseMeshKey        String   @default("knowme-human-v1")
  skeletonKey        String   @default("knowme-humanoid-v1")
  facialRigKey       String   @default("knowme-face-v1")
  materialProfileKey String   @default("knowme-pbr-skin-v1")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([updatedAt])
  @@index([schemaVersion, renderTier])
}

/// Durable Android Hero runtime evidence. Provenance fields are immutable after insertion;
/// consumedAtMs/certificationId form the database-enforced one-shot certification fence.
model HeroRuntimeEvidence {
  sessionId             String  @id
  schema                String
  sourceEvidenceSha256  String  @unique @db.Char(64)
  sessionEvidenceSha256 String  @db.Char(64)
  runtimeBundleSha256   String  @db.Char(64)
  appVersion            String
  commitSha             String  @db.Char(40)
  acceptedAtMs          BigInt
  consumedAtMs          BigInt?
  certificationId       String? @unique

  @@index([runtimeBundleSha256])
}
