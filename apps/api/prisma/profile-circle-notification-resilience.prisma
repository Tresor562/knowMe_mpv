enum ProfileCircleNotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ProfileCircleNotificationProviderCircuitStatus {
  CLOSED
  OPEN
  HALF_OPEN
}

enum ProfileCircleNotificationDeadLetterStatus {
  OPEN
  REPLAYING
  RESOLVED
  DISCARDED
}

enum ProfileCircleNotificationWebhookReceiptStatus {
  RECEIVED
  PROCESSED
  REJECTED
  FAILED
}

enum ProfileCircleNotificationSuppressionReason {
  USER_OPT_OUT
  HARD_BOUNCE
  COMPLAINT
  INVALID_ENDPOINT
  ADMINISTRATIVE
}

model ProfileCircleNotificationChannelPreference {
  id              String   @id @default(cuid())
  userId          String
  channel         ProfileCircleNotificationTransportChannel
  optionalEnabled Boolean  @default(true)
  digestEnabled   Boolean  @default(true)
  minimumPriority ProfileCircleNotificationPriority @default(LOW)
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, channel])
  @@index([userId, optionalEnabled])
}

model ProfileCircleNotificationProviderState {
  id                   String   @id @default(cuid())
  provider             String
  channel              ProfileCircleNotificationTransportChannel
  circuitStatus        ProfileCircleNotificationProviderCircuitStatus @default(CLOSED)
  consecutiveFailures  Int      @default(0)
  consecutiveSuccesses Int      @default(0)
  openedAt             DateTime?
  nextProbeAt          DateTime?
  lastFailureAt        DateTime?
  lastSuccessAt        DateTime?
  lastErrorCode        String?
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())

  @@unique([provider, channel])
  @@index([channel, circuitStatus, nextProbeAt])
}

model ProfileCircleNotificationSuppression {
  id          String   @id @default(cuid())
  userId      String
  channel     ProfileCircleNotificationTransportChannel
  addressHash String?
  reason      ProfileCircleNotificationSuppressionReason
  active      Boolean  @default(true)
  expiresAt   DateTime?
  note        String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, channel, active])
  @@index([addressHash, active])
  @@index([active, expiresAt])
}

model ProfileCircleNotificationRateBucket {
  key         String   @id
  count       Int      @default(0)
  limit       Int
  windowStart DateTime
  windowEnd   DateTime
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([windowEnd])
}

model ProfileCircleNotificationTemplate {
  id          String   @id @default(cuid())
  key         String
  version     Int
  locale      String
  channel     ProfileCircleNotificationTransportChannel
  subject     String?
  textBody    String
  htmlBody    String?
  active      Boolean  @default(false)
  metadata    Json?
  createdBy   String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, version, locale, channel])
  @@index([key, locale, channel, active])
}

model ProfileCircleNotificationDeadLetter {
  id             String   @id @default(cuid())
  attemptId      String?  @unique
  userId         String
  channel        ProfileCircleNotificationTransportChannel
  provider       String
  idempotencyKey String   @unique
  priority       ProfileCircleNotificationPriority @default(NORMAL)
  reasonCode     String
  payload        Json?
  status         ProfileCircleNotificationDeadLetterStatus @default(OPEN)
  replayCount    Int      @default(0)
  availableAt    DateTime @default(now())
  replayingAt    DateTime?
  resolvedAt     DateTime?
  discardedAt    DateTime?
  lastErrorCode  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, availableAt])
  @@index([userId, channel, createdAt])
}

model ProfileCircleNotificationWebhookReceipt {
  id            String   @id @default(cuid())
  provider      String
  eventId       String
  eventType     String
  attemptId     String?
  signatureHash String
  status        ProfileCircleNotificationWebhookReceiptStatus @default(RECEIVED)
  errorCode     String?
  metadata      Json?
  receivedAt    DateTime @default(now())
  processedAt   DateTime?
  updatedAt     DateTime @updatedAt

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@index([attemptId])
}

model ProfileCircleNotificationOperationalAlert {
  id          String   @id @default(cuid())
  code        String
  severity    ProfileCircleNotificationPriority
  fingerprint String   @unique
  title       String
  description String
  active      Boolean  @default(true)
  occurrences Int      @default(1)
  metadata    Json?
  openedAt    DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime @updatedAt

  @@index([active, severity, lastSeenAt])
}