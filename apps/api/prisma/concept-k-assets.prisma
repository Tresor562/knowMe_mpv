model ConceptKCharacterDefinition {
  id           String   @id @default(cuid())
  key          String
  version      Int
  displayName  String
  description  String
  originalWork Boolean  @default(true)
  licenseKey   String   @default("KNOWME_ORIGINAL")
  active       Boolean  @default(false)
  createdById  String
  reason       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assets ConceptKAssetManifest[]

  @@unique([key, version])
  @@index([key, active, version])
}

model ConceptKAssetManifest {
  id                String    @id @default(cuid())
  key               String
  version           Int
  eventKey          String
  characterId       String
  variant           String
  platform          String    @default("ALL")
  deviceClass       String    @default("ALL")
  publicUrl         String
  sha256            String
  bytes             Int
  mimeType          String
  durationMs        Int
  active            Boolean   @default(false)
  rolloutPercentage Int       @default(0)
  startsAt          DateTime  @default(now())
  endsAt            DateTime?
  quarantinedAt     DateTime?
  quarantineReason  String?
  quarantineSource  String?
  restoredAt        DateTime?
  restoredById      String?
  createdById       String
  reason            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  character ConceptKCharacterDefinition @relation(fields: [characterId], references: [id], onDelete: Restrict)
  deliveries ConceptKAssetDeliveryEvent[]

  @@unique([key, version])
  @@index([eventKey, variant, active, quarantinedAt, startsAt, endsAt])
  @@index([platform, deviceClass, active, quarantinedAt])
  @@index([characterId, active, version])
}

model ConceptKAssetDeliveryEvent {
  id             String   @id @default(cuid())
  userId         String
  assetId        String
  sampleDate     DateTime
  outcome        String
  durationMs     Int
  platform       String
  deviceClass    String
  observedSha256 String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  asset ConceptKAssetManifest @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([userId, assetId, sampleDate])
  @@index([assetId, createdAt, outcome])
  @@index([userId, createdAt])
}
