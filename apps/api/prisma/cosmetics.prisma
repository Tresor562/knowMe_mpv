model CosmeticItemDefinition {
  id          String    @id @default(cuid())
  key         String
  version     Int
  name        String
  description String?
  slot        String
  rarity      String    @default("COMMON")
  assetUrl    String
  previewUrl  String?
  active      Boolean   @default(false)
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  createdById String
  reason      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ownerships       CosmeticOwnership[]
  equippedBy       CosmeticEquipment[]
  offers           CosmeticOfferDefinition[]
  purchaseReceipts CosmeticPurchaseReceipt[]
  presetItems      CosmeticPresetItem[]

  @@unique([key, version])
  @@index([active, slot, startsAt, endsAt])
  @@index([key, active, version])
}

model CosmeticOwnership {
  id                String    @id @default(cuid())
  userId            String
  itemId            String
  source            String
  externalReference String?
  grantedById       String?
  reason            String
  acquiredAt        DateTime  @default(now())
  revokedAt         DateTime?
  revokedById       String?

  item CosmeticItemDefinition @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([userId, itemId])
  @@index([userId, revokedAt, acquiredAt])
  @@index([itemId, revokedAt])
  @@index([source, externalReference])
}

model CosmeticEquipment {
  id         String   @id @default(cuid())
  userId     String
  slot       String
  itemId     String
  equippedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  item CosmeticItemDefinition @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([userId, slot])
  @@index([userId, updatedAt])
  @@index([itemId])
}

model CosmeticPreset {
  id             String   @id @default(cuid())
  userId         String
  name           String
  normalizedName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items         CosmeticPresetItem[]
  activations   CosmeticPresetActivation[]
  defaultStates CosmeticPresetState[] @relation("DefaultCosmeticPreset")
  activeStates  CosmeticPresetState[] @relation("ActiveCosmeticPreset")

  @@unique([userId, normalizedName])
  @@index([userId, updatedAt])
}

model CosmeticPresetItem {
  id        String   @id @default(cuid())
  presetId  String
  slot      String
  itemId    String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  preset CosmeticPreset         @relation(fields: [presetId], references: [id], onDelete: Cascade)
  item   CosmeticItemDefinition @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([presetId, slot])
  @@index([itemId])
}

model CosmeticPresetState {
  userId            String   @id
  defaultPresetId   String?
  activePresetId    String?
  activationVersion Int      @default(0)
  updatedAt         DateTime @updatedAt

  defaultPreset CosmeticPreset? @relation("DefaultCosmeticPreset", fields: [defaultPresetId], references: [id], onDelete: SetNull)
  activePreset  CosmeticPreset? @relation("ActiveCosmeticPreset", fields: [activePresetId], references: [id], onDelete: SetNull)

  @@index([defaultPresetId])
  @@index([activePresetId])
}

model CosmeticPresetActivation {
  id                String    @id @default(cuid())
  userId            String
  presetId          String?
  presetName        String
  idempotencyKey    String    @unique
  equipmentSnapshot Json
  activatedAt       DateTime  @default(now())

  preset CosmeticPreset? @relation(fields: [presetId], references: [id], onDelete: SetNull)

  @@index([userId, activatedAt])
  @@index([presetId, activatedAt])
}

model CosmeticOfferDefinition {
  id             String    @id @default(cuid())
  key            String
  version        Int
  itemId         String
  priceKnowCoins Int
  active         Boolean   @default(false)
  startsAt       DateTime  @default(now())
  endsAt         DateTime?
  createdById    String
  reason         String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  item     CosmeticItemDefinition  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  receipts CosmeticPurchaseReceipt[]

  @@unique([key, version])
  @@index([active, startsAt, endsAt])
  @@index([itemId, active, version])
}

model CosmeticPurchaseReceipt {
  id             String   @id @default(cuid())
  userId         String
  offerId        String
  itemId         String
  priceKnowCoins Int
  idempotencyKey String   @unique
  ledgerEntryId  String   @unique
  purchasedAt    DateTime @default(now())

  offer CosmeticOfferDefinition @relation(fields: [offerId], references: [id], onDelete: Cascade)
  item  CosmeticItemDefinition  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, purchasedAt])
  @@index([offerId, purchasedAt])
}
