model DailyQuestProgress {
  id          String    @id @default(cuid())
  userId      String
  questKey    String
  questDate   DateTime
  target      Int
  progress    Int       @default(0)
  status      String    @default("IN_PROGRESS")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, questKey, questDate])
  @@index([userId, questDate])
}

model DailyQuestContribution {
  id             String   @id @default(cuid())
  userId         String
  questKey       String
  questDate      DateTime
  source         String
  referenceId    String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@unique([userId, questKey, questDate])
  @@index([userId, questDate])
}
