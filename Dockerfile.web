FROM node:22.23.2-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --filter @knowme/web... --frozen-lockfile=false

COPY apps/web apps/web
RUN pnpm --filter @knowme/web build

EXPOSE 3000
CMD ["pnpm", "--filter", "@knowme/web", "start"]
