FROM node:22-alpine
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --filter @knowme/web... --frozen-lockfile=false

COPY apps/web apps/web
RUN pnpm --filter @knowme/web build

EXPOSE 3000
CMD ["pnpm", "--filter", "@knowme/web", "start"]
